# Optional advanced API-key billing only. SIGMA and ChatGPT sign-in need no .env.
# Copy to ROOT/.env; never commit a real key. Existing shell values win.
# export OPENAI_API_KEY="replace-with-your-api-key"
# Restart with ./sigma ui, then explicitly choose API-key billing in Connect AI.
# Sponsored ChatGPT (optional) requires an explicitly configured private identity:
# SIGMA_CLOUD_SPONSOR_EMAIL=your-sponsor@example.test
# This is a placeholder. Never commit your actual sponsor email.
# SIGMA_AI_ENABLED is obsolete and is ignored. There is no enable switch.
