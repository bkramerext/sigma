SIGMA_CLOUD_AUTH_ENABLED=true
GOOGLE_OIDC_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_OIDC_CLIENT_SECRET=replace-with-google-oauth-client-secret
SIGMA_CLOUD_PUBLIC_ORIGIN=https://sigma.example.org
SIGMA_CLOUD_BOOTSTRAP_ADMIN_EMAIL=admin@example.org
SIGMA_CLOUD_ADMIN_CONTACT_EMAIL=admin@example.org
SIGMA_CLOUD_AUTH_HOME=/var/lib/sigma/auth
SIGMA_CLOUD_WORKSPACES_ROOT=/var/lib/sigma/workspaces
SIGMA_CLOUD_DEMO_AUDIT=/app/cloud-demo/handshake-demo-audit.json
