[Unit]
Description=Application-consistent SIGMA state disk snapshot and retention
Requires=srv-sigma\x2dstate.mount
After=srv-sigma\x2dstate.mount sigma.service
RequiresMountsFor=/srv/sigma-state
OnFailure=sigma-backup-failure.service

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/sigma/backup-state.sh
EnvironmentFile=/etc/sigma/backup.env
Environment=CLOUDSDK_CONFIG=/var/lib/sigma-backup/gcloud
Environment=HOME=/var/lib/sigma-backup
TimeoutStartSec=30min
User=root
Group=root
UMask=0077
PrivateTmp=true
ProtectHome=true
NoNewPrivileges=true
ProtectSystem=strict
ReadOnlyPaths=/srv/sigma-state
ReadWritePaths=/var/lib/sigma-backup /run/lock
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
