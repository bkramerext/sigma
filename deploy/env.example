# Copy to a private deployment env file; this file contains no credential values.
SIGMA_RELEASE=reviewed-commit-sha
SIGMA_DOMAIN=sigma-research.duckdns.org
SIGMA_CADDY_SCHEME=https
SIGMA_TLS_EMAIL=operator@example.org
# Public invitation contact. Existing administrator identity remains bound to
# its Google subject in the auth database when this contact address changes.
SIGMA_CLOUD_ADMIN_CONTACT_EMAIL=zetacontinuation@gmail.com
GOOGLE_OIDC_CLIENT_ID=replace-with-web-client-id.apps.googleusercontent.com
SIGMA_GOOGLE_OIDC_CLIENT_SECRET_FILE=/run/sigma-secrets/google-oauth-client-secret
SIGMA_CLOUD_OPENAI_API_KEY_FILE=/run/sigma-secrets/openai-api-key
SIGMA_INVITATION_SMTP_USERNAME=sigma-notifications@example.org
SIGMA_INVITATION_SMTP_PASSWORD_FILE=/run/sigma-secrets/invitation-smtp-password
SIGMA_CLOUD_USER_SPEND_CEILING_USD=2.00
SIGMA_CLOUD_GLOBAL_SPEND_CEILING_USD=15.00
SIGMA_CLOUD_USER_MAX_CONCURRENT=1
SIGMA_CLOUD_GLOBAL_MAX_CONCURRENT=1
SIGMA_CLOUD_USER_MAX_QUEUED=2
SIGMA_CLOUD_GLOBAL_MAX_QUEUED=8
SIGMA_CLOUD_USER_TOKEN_BUDGET=2000000
# Set to the dedicated sigma-sandbox user's actual runtime socket and primary GID.
SIGMA_SANDBOX_DOCKER_SOCKET=/run/user/1002/docker.sock
SIGMA_SANDBOX_DOCKER_GID=1002
SIGMA_STATE_DISK_MOUNT=/srv/sigma-state

# Explicit sponsor provider. ChatGPT requires protected SIWC provisioning first.
SIGMA_CLOUD_INFERENCE_PROVIDER=chatgpt
# Set with provider=chatgpt; separate from the public invitation contact.
SIGMA_CLOUD_SPONSOR_EMAIL=zetacontinuation@gmail.com
# Deployment-wide opt-in. Eligible, invited accounts start and remain in
# sponsored mode while enabled; ineligible and guest accounts receive no access.
SIGMA_CLOUD_SPONSORED_ENABLED=false
SIGMA_CLOUD_FORCE_SPONSORED_MODE=false
