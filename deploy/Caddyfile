{
	email {$SIGMA_TLS_EMAIL}
}

{$SIGMA_CADDY_SCHEME}://{$SIGMA_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
	}
	@api path /api /api/*
	handle @api {
		reverse_proxy backend:8000 {
			header_up X-Forwarded-Proto {$SIGMA_CADDY_UPSTREAM_SCHEME}
		}
	}
	handle {
		reverse_proxy frontend:8080 {
			header_up X-Forwarded-Proto {$SIGMA_CADDY_UPSTREAM_SCHEME}
		}
	}
}
