[Unit]
Description=SIGMA synthetic Personal browser preview host broker
Documentation=https://github.com/bkramerext/sigma/issues/874
After=docker.service
Requires=docker.service
ConditionPathExists=/etc/sigma/personal-lab.env

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=/etc/sigma/personal-lab.env
WorkingDirectory=/opt/sigma/personal-lab/release
ExecStart=/usr/bin/python3 /opt/sigma/personal-lab/release/auth-poc/host_broker.py
Restart=on-failure
RestartSec=2s
RuntimeDirectory=sigma-personal-broker sigma-personal-gateways
RuntimeDirectoryMode=0711
RuntimeDirectoryPreserve=restart
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectProc=invisible
LockPersonality=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=CAP_CHOWN
AmbientCapabilities=CAP_CHOWN
Environment=SIGMA_AUTH_BROKER_ISOLATED_NETWORK=1
ReadWritePaths=/run/sigma-personal-broker /run/sigma-personal-gateways /srv/sigma-state/auth/personal-lab
UMask=0077
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sigma-personal-lab-broker

[Install]
WantedBy=multi-user.target
